#!/bin/bash
# Allow internet for updates (do not forget net-offline afterwards)
set -euo pipefail
CONF="${LAN_ONLY_ONLINE_CONF:-/etc/nftables-online.conf}"
if [[ ! -f "$CONF" ]]; then
  echo "missing: $CONF — run install.sh first" >&2
  exit 1
fi
nft -f "$CONF"
# Boot default stays LAN: do not switch nftables.conf to online
echo "Internet ON — afterwards: sudo net-offline"
echo "Tip: sudo apt update && sudo apt full-upgrade && sudo net-offline"

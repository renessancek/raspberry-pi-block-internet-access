#!/bin/bash
# LAN only — internet blocked
set -euo pipefail
CONF="${LAN_ONLY_LAN_CONF:-/etc/nftables-lan.conf}"
if [[ ! -f "$CONF" ]]; then
  echo "missing: $CONF — run install.sh first" >&2
  exit 1
fi
nft -f "$CONF"
# Ensure boot loads LAN rules again
cp -f "$CONF" /etc/nftables.conf
echo "Internet OFF — LAN only ($CONF)"
